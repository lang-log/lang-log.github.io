{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lang-log.com/schema/languoid.schema.json",
  "title": "Lang Log languoid",
  "description": "One languoid of Lang Log. Lang Log does not sort languoids into families, languages, dialects or clades: every record has this one shape, and where it sits is its parent in each source. Whether a source calls it a family, language or dialect is that source's claim, kept as classification.<source>.level. Every value says which source and version it came from. The only labels Lang Log gives a languoid itself are its modality (spoken, signed, written) and whether it is constructed (an artificial or formal language); every languoid of every modality is in one tree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "path",
    "codes",
    "names",
    "classification",
    "location",
    "macroarea",
    "countries",
    "isolate",
    "modality",
    "constructed",
    "features",
    "registry",
    "scripts",
    "linguameta",
    "phonemes",
    "societies",
    "speakers_by_country",
    "plural_categories",
    "endangerment",
    "description",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "id": {
      "type": "string",
      "description": "Glottocode, or <source>:<id in that source> for a record that exists only in another source."
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "description": "URL path below https://lang-log.com/, without leading or trailing slash."
    },
    "codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glottocode", "iso639_3", "wals"],
      "properties": {
        "glottocode": {
          "type": ["string", "null"]
        },
        "iso639_3": {
          "type": ["string", "null"]
        },
        "wals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "names": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "lang", "provider", "same_language", "source"],
        "properties": {
          "text": {
            "type": "string"
          },
          "lang": {
            "type": "string",
            "description": "Language tag of the name as the source gives it; empty when not given."
          },
          "provider": {
            "type": "string"
          },
          "same_language": {
            "type": "boolean",
            "description": "The name is recorded in the language itself (its tag matches the record's ISO 639-3 code)."
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "description": "Place of this languoid in each source that classifies it: {<source>: {parent, level}}. parent is a Lang Log id or null (top of that source's tree); level is what that source calls it (Glottolog: family, language, dialect; WALS: family, subfamily, genus, language), left out when the source gives none. grouping is a catalog group the source lists the languoid under that is not a languoid itself (Glottolog: Sign Language, L1 Sign Language ...); Lang Log keeps it as the source's claim and leaves the group out of the tree (source-data/lang-log/not-languoids.json). Lang Log's own classification (source lang-log) gives a parent only, such as a historical stage as the parent of the later language. The site nests languoids by Glottolog's parents.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent"],
        "properties": {
          "parent": {
            "type": ["string", "null"]
          },
          "level": {
            "type": "string"
          },
          "grouping": {
            "type": "string"
          }
        }
      }
    },
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["latitude", "longitude", "source"],
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "macroarea": {
      "type": ["string", "null"]
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isolate": {
      "type": "boolean"
    },
    "modality": {
      "type": "string",
      "enum": ["spoken", "signed", "written"],
      "description": "The physical medium: spoken (and its written use), signed, or a writing system."
    },
    "constructed": {
      "type": "boolean",
      "description": "An artificial or formal language (a conlang, a code, a programming or logical language)."
    },
    "features": {
      "type": "object",
      "description": "Values of Lang Log features (features/index.json), keyed by feature id. A feature without data is left out.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "evidence"],
        "properties": {
          "value": {
            "type": "string",
            "description": "Lang Log value id, chosen from the evidence by source priority."
          },
          "disagreement": {
            "type": "boolean",
            "description": "Present and true when the evidence gives more than one value."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "version", "feature", "value", "raw"],
              "properties": {
                "source": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "feature": {
                  "type": "string",
                  "description": "Feature id in that source, such as WALS 81A."
                },
                "value": {
                  "type": "string",
                  "description": "Lang Log value id."
                },
                "raw": {
                  "type": "string",
                  "description": "The value as the source writes it."
                },
                "record": {
                  "type": "string",
                  "description": "The source's own id of the language the value was recorded for."
                },
                "reference": {
                  "type": "string"
                },
                "comment": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "registry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["tag", "scope", "macrolanguage", "replaced_by", "retired", "script", "source"],
      "properties": {
        "tag": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": ["individual", "macrolanguage", "collection", "special", "private-use"]
        },
        "macrolanguage": {
          "type": ["string", "null"]
        },
        "replaced_by": {
          "type": ["string", "null"]
        },
        "retired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "script": {
          "type": ["string", "null"]
        },
        "source": {
          "type": "string",
          "enum": ["iana"]
        }
      },
      "description": "What the IANA Language Subtag Registry says of the record's ISO 639-3 code: its language tag (the ISO 639-1 code where there is one), its scope, the macrolanguage it belongs to, the tag that replaced it if it was retired, the retired tags it replaced, and the script its tags leave out. Null without an ISO 639-3 code in the registry."
    },
    "scripts": {
      "type": "array",
      "description": "Scripts the language is written in, from Unicode CLDR (main and other scripts), the IANA registry (the script its tags leave out) and LinguaMeta (scripts CLDR and IANA lack, as main scripts).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["script", "use", "source"],
        "properties": {
          "script": {
            "type": "string",
            "pattern": "^[A-Z][a-z]{3}$",
            "description": "ISO 15924 code."
          },
          "use": {
            "type": "string",
            "enum": ["main", "other"]
          },
          "source": {
            "type": "string",
            "enum": ["cldr", "iana", "linguameta"]
          }
        }
      }
    },
    "linguameta": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["speakers", "scripts", "endangerment", "iso639_2b", "wikidata", "source"],
      "description": "From LinguaMeta (CC BY-SA 4.0; these values stay under that license): estimated number of speakers, scripts, endangerment status, ISO 639-2/B code and Wikidata item. Matched by Glottocode, else by ISO 639-3 code.",
      "properties": {
        "speakers": {
          "type": ["integer", "null"]
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endangerment": {
          "type": ["string", "null"],
          "enum": [
            "Not endangered",
            "Vulnerable",
            "Definitely endangered",
            "Severely endangered",
            "Critically endangered",
            "Extinct",
            null
          ]
        },
        "iso639_2b": {
          "type": ["string", "null"]
        },
        "wikidata": {
          "type": ["string", "null"],
          "pattern": "^Q[0-9]+$"
        },
        "source": {
          "type": "string",
          "enum": ["linguameta"]
        }
      }
    },
    "phonemes": {
      "type": "array",
      "description": "PHOIBLE's phoneme inventories of the languoid, by Glottocode.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inventory", "contributor", "consonants", "vowels", "tones", "source"],
        "properties": {
          "inventory": {
            "type": "string"
          },
          "contributor": {
            "type": "string"
          },
          "consonants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vowels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "enum": ["phoible"]
          }
        }
      }
    },
    "societies": {
      "type": "array",
      "description": "From D-PLACE (CC BY-NC 4.0; never used in a paid feature): the societies whose language this languoid is.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["society", "name", "region", "focal_year", "source"],
        "properties": {
          "society": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "region": {
            "type": ["string", "null"]
          },
          "focal_year": {
            "type": ["integer", "null"]
          },
          "source": {
            "type": "string",
            "enum": ["dplace"]
          }
        }
      }
    },
    "speakers_by_country": {
      "type": "array",
      "description": "From Unicode CLDR: the share of each country's population that uses the language, and its official status there.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country", "population_percent", "official_status", "source"],
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2,3}$"
          },
          "population_percent": {
            "type": "number"
          },
          "official_status": {
            "type": ["string", "null"],
            "enum": ["official", "de_facto_official", "official_regional", null]
          },
          "source": {
            "type": "string",
            "enum": ["cldr"]
          }
        }
      }
    },
    "plural_categories": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["values", "source"],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["zero", "one", "two", "few", "many", "other"]
          }
        },
        "source": {
          "type": "string",
          "enum": ["cldr"]
        }
      },
      "description": "The cardinal plural categories of the language, from Unicode CLDR."
    },
    "endangerment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "not endangered",
            "threatened",
            "shifting",
            "moribund",
            "nearly extinct",
            "extinct"
          ]
        },
        "source": {
          "type": "string",
          "enum": ["glottolog"]
        }
      },
      "description": "Glottolog's agglomerated endangerment status."
    },
    "description": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "long grammar",
            "grammar",
            "grammar sketch",
            "phonology/text",
            "Wordlist or less"
          ]
        },
        "reference": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["glottolog"]
        }
      },
      "description": "The most extensive description of the language known to Glottolog, and its reference."
    },
    "sources": {
      "type": "object",
      "description": "Source id -> version of every source this record has data from.",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
