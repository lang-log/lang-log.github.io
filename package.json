{
  "name": "lang-log",
  "private": true,
  "description": "Code quality tools for Lang Log (formatting and linting only; the site needs no Node.js packages).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint .",
    "lint:python": "ruff check .",
    "format:python": "ruff format .",
    "format:python:check": "ruff format --check .",
    "check": "npm run format:check && npm run lint:js && npm run lint:md && npm run lint:html && npm run lint:css && npm run lint:python && npm run format:python:check",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:html": "html-validate \"dist/*.html\"",
    "lint:css": "stylelint \"dist/*.css\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prettier/plugin-xml": "3.4.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "html-validate": "11.21.1",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.9.10",
    "stylelint": "18.0.0"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "katex": "0.19.1"
  }
}
