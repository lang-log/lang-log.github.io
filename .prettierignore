# Files Prettier leaves alone. Prettier also skips everything in .gitignore (the pages and data
# that tools/build_site.sh writes into dist/, node_modules/, _preview/).
# Why each entry is here: .claude/rules/code-quality.md.

# Written by npm.
package-lock.json

# Source data: third-party datasets and saved pages kept as published, and the hand-curated
# data and text that the build scripts read as they are.
source-data/

# Committed files written by scripts in tools/ (data and its XML exports, map tiles, the ISO
# table, the logo).
dist/integrated.json
dist/provenance.json
dist/signs-and-scripts.json
dist/language-atlas.xml
dist/signs-and-scripts.xml
dist/hf-iso-map.js
dist/logo.svg
dist/map/

# Hand-written pages: tools/security_policy.py --write puts the policy <meta> tags right after
# <meta charset="utf-8"> as one exact string, and --check compares them as text.
dist/*.html

