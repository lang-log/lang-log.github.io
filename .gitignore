__pycache__/
*.pyc
node_modules/
.env
.env.*

# Atlas data and exports written by tools/build_site.sh from source-data/.
/dist/data.json
/dist/integrated.json
/dist/provenance.json
/dist/language-families.xml
/dist/language-families.opml
/dist/language-families.*.gz
/dist/signs-and-scripts.json
/dist/signs-and-scripts.xml
/dist/signs-and-scripts.opml
/dist/random.json
# The Releases page and its data (tools/build_releases.py), and the API answer it
# is built from.
/dist/releases.html
/dist/releases.json
/build/
# The sitemap and robots.txt (tools/build_sitemap.py).
/dist/sitemap*.xml
/dist/robots.txt
# Record pages written by build_paths.py (one directory per top-level family
# and per source). Committed directories under dist/ are listed with !.
/dist/*/
!/dist/map/
/dist/stages.json
/dist/paths.json
/dist/source-paths.json
/_preview/
/dist/index.html
# The interface dictionaries, written by tools/build_i18n.py from i18n/*.yaml.
/dist/i18n.js
/dist/i18n/
.ruff_cache/
