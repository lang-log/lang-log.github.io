></outline><outline text="Kui (Indonesia)" node-id="kuii1253" source="robinson_and_holton2012"><outline text="Conditional placements"><outline text="According to Glottolog 5.3: Central Alor" url="https://doi.org/10.5281/zenodo.18840935" node-ref="alor1250" /><outline text="According to WALS Online / CLDF: Alor-Pantar" url="https://wals.info" node-ref="wals:genus-alorpantar" /><outline text="According to Robinson and Holton (2012): Clade: Adang, Alor-Pantar, Blagar …" url="https://doi.org/10.1163/22105832-20120201" node-ref="ph:robinson_and_holton2012:9" /></outline></outline></outline></outline></outline></outline></outline><outline text="Mongolic-Khitan" node-id="mong1349" source="glottolog"><outline text="Mongolic" node-id="mong1329" source="glottolog"><outline text="Transeurasian relationship — Disputed genealogical proposal; no consensus implied"><outline text="Robbeets et al. (2021): Under the Transeurasian hypothesis, Japonic, Koreanic, Tungusic, Mongolic and Turkic are branches of one proposed genealogical group." url="https://doi.org/10.1038/s41586-021-04108-8" publication="Nature article" /><outline text="Tian et al. (2022): This critique argues that the linguistic, genetic and archaeological analyses do not provide conclusive evidence for that family or its proposed farming dispersal. This is rejection of the evidence, not a demonstrated alternative superfamily." url="https://doi.org/10.1101/2022.06.09.495471" publication="bioRxiv preprint, version 1" /><outline text="Robbeets et al. (2022): The response revises datasets and approaches while defending the proposed relationship and the triangulation argument." url="https://doi.org/10.1101/2022.10.05.510045" publication="bioRxiv preprint, version 1" /></outline><outline text="Mogholi" node-id="mogh1245" source="glottolog"><outline text="Conditional placements"><outline text="According to Glottolog 5.3: Mongolic" url="https://doi.org/10.5281/zenodo.18840935" node-ref="mong1329" /><outline text="According to W